# Export these values in the process environment. This file is not auto-loaded.
OMNIA_LAYA_REVISION=
OMNIA_LAYA_MODEL=english
OMNIA_LAYA_DEVICE=cpu
OMNIA_LAYA_THREADS=2
OMNIA_LAYA_MAX_LEN=512
OMNIA_LAYA_HEAD_MAX_LEN=192
OMNIA_LAYA_MAX_INPUT_BYTES=65536
OMNIA_LAYA_MIN_PROBABILITY=0.8
OMNIA_TRADING_DATABASE=var/trading/decisions.sqlite3
OMNIA_TRADING_MAX_RECORDS=1000
OMNIA_TRADING_MAX_AGE_SECONDS=120
OMNIA_TRADING_MIN_MARKET_CAP_USD=30000
OMNIA_TRADING_MIN_LIQUIDITY_USD=10000
OMNIA_TRADING_REQUIRE_MARKET_CAP=false
OMNIA_TRADING_REQUIRE_LIQUIDITY=false
OMNIA_TRADING_REQUIRE_HONEYPOT_REPORT=false

# Strategy thresholds are supplied in each strategy_policy JSON object.
# Inspect defaults: omnia-trading --strategy-policy
# Process account-bound inputs: omnia-trading --strategy --input strategy-observations.jsonl
